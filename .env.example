# Copy this file to .env and fill it in. Never commit .env.

# --- Website ---
HOST=127.0.0.1
PORT=8000
# The address members use. Must match the Discord redirect below.
PUBLIC_URL=http://127.0.0.1:8000

# Encrypts saved cards, retailer passwords and inbox keys. Leave blank to have one
# generated into data/secret.key on first run. Back it up: lose it and saved
# secrets can't be read. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BUFFSQUAD_SECRET_KEY=

# --- Discord app (https://discord.com/developers/applications > New Application) ---
# OAuth2 page: copy Client ID and Client Secret, and add this redirect:
#   <PUBLIC_URL>/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Bot page: Reset Token, copy it here. Turn ON "Message Content Intent".
# Invite the bot to your server (OAuth2 > URL Generator > scope "bot", permissions
# View Channels + Read Message History) so it can read the checkout channel.
DISCORD_BOT_TOKEN=

# Your server's ID (right-click the server icon > Copy Server ID, with Developer Mode on).
# When set, only members of that server can sign in to the dashboard.
DISCORD_GUILD_ID=

# Comma-separated Discord user IDs that get the admin panel (/admin).
ADMIN_DISCORD_IDS=

# Your own Discord user ID. Only you see the Master log on the admin panel: which
# profiles and accounts each admin downloaded, whose, and every change they made.
# Admins can't see it. You get the admin panel too, so no need to repeat it above.
OWNER_DISCORD_IDS=

# Channels to watch are managed on the admin panel's Channels tab. This is only
# the starting list the first time the bot runs (comma-separated channel IDs).
CHECKOUT_CHANNEL_IDS=

# Local testing only: lets /auth/dev sign in without Discord, from this computer only.
DEV_LOGIN=0
